{
  "name": "personal-jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JARVIS - a personal voice AI assistant that runs in the browser",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c green,cyan \"npm:dev:bridge\" \"npm:dev:web\"",
    "dev:bridge": "node bridge/server.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "mcp:add": "node scripts/mcp-add.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@fontsource/orbitron": "^5.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
