# Copy to .env and fill in. Never commit .env.
# Restart the bridge after editing this file (it is read once at boot).
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# The ElevenLabs voice used for TTS. This env var is the real control for the voice.
JARVIS_VOICE_ID=
# Optional
# BRIDGE_PORT=8787
# JARVIS_MODEL=claude-sonnet-5-5
