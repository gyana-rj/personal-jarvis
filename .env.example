# Copy to .env and fill in. Never commit .env.
# Restart the bridge after editing this file (it is read once at boot).

# Which brain to use: gemini (default, free key) | anthropic (optional, uses the Claude Agent SDK)
LLM_PROVIDER=gemini
# Optional model override. Empty = gemini-3.8-flash (gemini) or the SDK default (anthropic)
LLM_MODEL=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model for the Google-Search-grounded web_search call (grounding is free on 2.5 Flash). Optional.
# GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional: ElevenLabs voice. Without these Jarvis uses your browser's built-in voice (free).
ELEVENLABS_API_KEY=
# The ElevenLabs voice used for TTS. This env var is the real control for the voice.
JARVIS_VOICE_ID=

# Optional
# BRIDGE_PORT=8787
